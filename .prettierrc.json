{
	"trailingComma": "all",
	"tabWidth": 4,
	"semi": true,
	"singleQuote": true,
	"useTabs": true,
	"bracketSpacing": true,
	"bracketSameLine": true,
	"arrowParens": "always",
	"printWidth": 140,
	"htmlWhitespaceSensitivity": "ignore",
	"singleAttributePerLine": true,
	"overrides": [
		{
			"files": "*.html",
			"options": {
				"parser": "angular"
			}
		}
	]
}
